{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["#[", "]"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["#[", "]"],
        ["\"", "\""],
        ["\"\"\"", "\"\"\""]
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["#[", "]"],
        ["\"", "\""],
        ["\"\"\"", "\"\"\""]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(fn|if|elseif|else|while|for|export fn).*\\{\\s*$",
        "decreaseIndentPattern": "^\\s*\\}\\s*$"
    },
    "folding": {
        "markers": {
            "start": "^\\s*/\\*",
            "end": "^\\s*\\*/"
        }
    }
}