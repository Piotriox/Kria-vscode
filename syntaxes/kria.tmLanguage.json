{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Kria",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#builtins"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#booleans"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.kria",
					"match": "//.*$"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.kria",
					"match": "\\b(if|else|while|fn|set|return)\\b"
				}
			]
		},
		"builtins": {
			"patterns": [
				{
					"name": "support.function.builtin.kria",
					"match": "\\b(print|input)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.kria",
					"match": "(\\+|-|\\*|/|==|!=|>=|<=|>|<|=)"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.kria",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.kria",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.kria",
					"match": "\\b\\d+(\\.\\d+)?\\b"
				}
			]
		},
		"booleans": {
			"patterns": [
				{
					"name": "constant.language.kria",
					"match": "\\b(true|false|null)\\b"
				}
			]
		}
	},
	"scopeName": "source.kria"
}