{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Kria",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#for-in-object"
		},
		{
			"include": "#array-assignment"
		},
		{
			"include": "#builtins"
		},
		{
			"include": "#arrays"
		},
		{
			"include": "#objects"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#booleans"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#generics"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.kria",
					"match": "//.*$"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.kria",
					"match": "\\b(if|else|while|for|in|fn|set|return|break|continue|export|import|from)\\b"
				}
			]
		},
		"builtins": {
			"patterns": [
				{
					"name": "support.function.builtin.kria",
					"match": "\\b(print|input|push|pop|rmv)\\b"
				},
				{
					"name": "support.other.kria",
					"match": "\\.(length)\\b"
				}
			]
		},
		"generics": {
			"patterns": [
				{
					"name": "entity.name.type.kria",
					"match": "<(str|int|float)>"
				}
			]
		},
		"arrays": {
			"patterns": [
				{
					"name": "meta.array.kria",
					"begin": "\\[",
					"end": "\\]",
					"patterns": [
						{
							"include": "#numbers"
						},
						{
							"include": "#strings"
						},
						{
							"include": "#booleans"
						}
					]
				},
				{
					"name": "meta.array.immutable.kria",
					"begin": "#\\[",
					"end": "\\]",
					"patterns": [
						{
							"include": "#numbers"
						},
						{
							"include": "#strings"
						},
						{
							"include": "#booleans"
						}
					]
				},
				{
					"name": "meta.array.access.kria",
					"match": "\\[\\s*\\d+\\s*\\]"
				}
			]
		},
		"objects": {
			"patterns": [
				{
					"name": "meta.object.kria",
					"begin": "\\{",
					"end": "\\}",
					"patterns": [
						{
							"name": "variable.other.kria",
							"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
						},
						{
							"include": "#strings"
						},
						{
							"include": "#numbers"
						},
						{
							"include": "#booleans"
						},
						{
							"include": "#arrays"
						}
					]
				},
				{
					"name": "meta.object.property.kria",
					"match": "\\.(\\w+)"
				},
				{
					"name": "meta.object.bracket.access.kria",
					"match": "\\[\\s*['\"]\\w+['\"]\\s*\\]"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.kria",
					"match": "(\\+|-|\\*|/|==|!=|>=|<=|>|<|=)"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.kria",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.kria",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.kria",
					"match": "\\b\\d+(\\.\\d+)?\\b"
				}
			]
		},
		"booleans": {
			"patterns": [
				{
					"name": "constant.language.kria",
					"match": "\\b(true|false|null)\\b"
				}
			]
		},
		"for-in-object": {
			"patterns": [
				{
					"name": "meta.for-in-object.kria",
					"match": "\\bfor\\s+(\\w+)\\s*,\\s*(\\w+)\\s+in\\b",
					"captures": {
						"1": { "name": "variable.other.kria" },
						"2": { "name": "variable.other.kria" }
					}
				}
			]
		},
		"array-assignment": {
			"patterns": [
				{
					"name": "meta.array.assignment.kria",
					"match": "(\\w+)\\[(\\d+)\\]\\s*=",
					"captures": {
						"1": { "name": "variable.other.kria" },
						"2": { "name": "constant.numeric.kria" }
					}
				}
			]
		}
	},
	"scopeName": "source.kria"
}